title: "Tsukuyomi"
message: "If you use this work in academic or public writing, please cite it as below."
type: software
version: "1.0.0"
date-released: "2026-04-21"
license: Apache-2.0
repository-code: "https://github.com/RichardClawson013/Tsukuyomi"
authors:
